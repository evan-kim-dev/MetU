# Frontend (Next.js) — commit-safe template
# Copy to `.env.local` and fill values. Never commit real secrets.

# Browser-safe Supabase (RLS required)
NEXT_PUBLIC_SUPABASE_URL=https://jlcdewbwbtfwasnpqfcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Canonical production origin (OAuth callback / cache-bust redirects)
# Vercel: set to https://met-u.vercel.app
# NEXT_PUBLIC_SITE_URL=https://met-u.vercel.app

# 항공/호텔 딥링크 카드 (P1-A). 0 이면 숨김
# NEXT_PUBLIC_TRAVEL_LINKS=1

# 크론/내부 라우트 보호 (Vercel Cron Authorization Bearer). 프로덕션 필수.
# INTERNAL_API_SECRET=long-random-string
# CRON_SECRET=long-random-string

# 게스트 httpOnly 쿠키 HMAC (GUEST_COOKIE_SECRET). 프로덕션 필수.
# GUEST_COOKIE_SECRET=long-random-string

# BFF AI 라우트 분당 한도 (기본 20)
# AI_RATE_LIMIT_PER_MIN=20

# 카카오 REST API 키 (앱 관리 > 앱 키). 카카오계정과 함께 로그아웃에 사용 (클라이언트)
# NEXT_PUBLIC_KAKAO_REST_API_KEY=
# 카카오 Local(장소 검색) 서버 전용 — NEXT_PUBLIC 으로 만들지 말 것. 카카오맵 [사용 설정] ON.
# 무료 쿼터는 계정의 첫 활성화 앱에만 해당 → 앱을 새로 만들지 말 것.
# KAKAO_REST_API_KEY=

# Google Places API (New) 서버 키 — API 제한: Places API (New) + Routes API
# GOOGLE_MAPS_SERVER_API_KEY=
# 이동시간 행렬 공급자: auto | google | kakao | osrm | haversine (기본 auto)
# ROUTE_MATRIX_PROVIDER=
# 선택 OSRM table API 베이스 URL (미설정 시 OSRM 폴백 비활성)
# OSRM_BASE_URL=
# Kakao 도보/대중교통 정밀화 일일 호출 예산(프로세스 메모리, 기본 800)
# KAKAO_ROUTE_DAILY_BUDGET=800
# 디버그용 공급자 강제: kakao | google
# PLACE_PROVIDER_OVERRIDE=
# 실존 장소 후보 기반 일정 폴백 (1 = on)
# PLACE_ITINERARY_ENABLED=

# --- 브라우저 지도 (Step 2) — 서버 키와 절대 같은 값을 쓰지 말 것 ---
# Kakao JavaScript 키 + [JavaScript SDK 도메인] 등록(포트 포함), 카카오맵 사용 설정 ON
# NEXT_PUBLIC_KAKAO_JS_KEY=
# Google Maps JavaScript API 만 허용 + HTTP referrer 제한
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# AdvancedMarker 용 Map ID (없으면 DEMO_MAP_ID)
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# --- 이동시간 행렬 (Step 3) ---
# auto | google | kakao | osrm | haversine
# ROUTE_MATRIX_PROVIDER=auto
# OSRM_BASE_URL=
# Kakao 도보/대중교통 일일 자체 상한 (기본 800)
# KAKAO_ROUTE_DAILY_BUDGET=800

# --- Supabase Kakao Auth (프로젝트: jlcdewbwbtfwasnpqfcj) ---
# 1) Supabase Dashboard → Auth → Providers → Kakao
#    - Client ID  = 카카오 REST API 키
#    - Client Secret = 카카오 Client Secret (코드 ON 후 발급) ← 프론트 .env에 넣지 않음
# 2) Kakao Developers → 카카오 로그인 → Redirect URI:
#    https://jlcdewbwbtfwasnpqfcj.supabase.co/auth/v1/callback
# 3) Supabase → Auth → URL Configuration
#    Site URL: https://met-u.vercel.app
#    Redirect URLs:
#      http://localhost:3000/auth/callback
#      https://met-u.vercel.app/auth/callback
#    (예전 *.vercel.app 미리보기 URL은 Redirect URLs에서 제거)

# Do NOT put these in Next (browser):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Server-only (Next API routes — no NEXT_PUBLIC_ prefix):
# SUPABASE_URL=https://jlcdewbwbtfwasnpqfcj.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

