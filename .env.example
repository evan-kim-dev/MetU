# MetU — copy to `.env.local` and fill values. Never commit real secrets.

# =============================================================================
# Required (app won't work without these)
# =============================================================================

# Browser Supabase (RLS required). Prefer publishable key; anon still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server Supabase admin (agent/places cache). Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (agent + insight). Never NEXT_PUBLIC_.
GEMINI_API_KEY=

# Ingest token hash pepper. Missing → ingest/token APIs return 503.
AGENT_INGEST_PEPPER=

# Guest cookie HMAC + cron Bearer. Production required.
GUEST_COOKIE_SECRET=
CRON_SECRET=

# =============================================================================
# Optional — public (NEXT_PUBLIC_*)
# =============================================================================

# Canonical origin for OAuth / redirects (e.g. https://met-u.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# Flight/hotel deeplink cards. Hide with false | 0 | off
# NEXT_PUBLIC_TRAVEL_LINKS=true

# Kakao JS map key (domain allowlist). Not the same as REST key.
# NEXT_PUBLIC_KAKAO_JS_KEY=

# Kakao REST key used only for client logout URL helper (not Local search).
# NEXT_PUBLIC_KAKAO_REST_API_KEY=

# Google Maps JS (HTTP referrer restricted) + optional Map ID
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# Web Push (public half)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# iOS Shortcut gallery link for automation onboarding
# NEXT_PUBLIC_IOS_SHORTCUT_URL=

# Build stamp / SW cache bust (often set by CI)
# NEXT_PUBLIC_BUILD_TAG=

# Demo mode (가계부 화면의 데모 패널 + /api/agent/demo/{seed,notify}). Default: off.
# 1 일 때만 패널이 보이고 라우트가 동작해요. 꺼져 있으면 라우트는 404 예요.
# 빌드 타임 변수예요: Vercel 에서 값을 바꾼 뒤에는 반드시 재배포해야 반영돼요. (비밀값 아님)
# NEXT_PUBLIC_DEMO_MODE=1

# =============================================================================
# Optional — server only
# =============================================================================

# Places / routes
# KAKAO_REST_API_KEY=
# GOOGLE_MAPS_SERVER_API_KEY=
# PLACE_PROVIDER_OVERRIDE=          # kakao | google
# PLACE_ITINERARY_ENABLED=1
# ROUTE_MATRIX_PROVIDER=auto        # auto | google | kakao | osrm | haversine
# OSRM_BASE_URL=
# KAKAO_ROUTE_DAILY_BUDGET=800

# Gemini tuning
# GEMINI_MODEL_MAIN=gemini-3.8-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_THINKING_MAIN=low
# GEMINI_THINKING_FAST=minimal
# GEMINI_TIMEOUT_MS=25000
# GEMINI_MAX_RETRIES=2

# Rate limits / AI
# AI_RATE_LIMIT_PER_MIN=20
# AI_VISION_RATE_LIMIT_PER_MIN=6
# AI_MAX_PROMPT_CHARS=4000
# AI_MAX_MESSAGES=20

# Agent policy / settle
# AGENT_AUTO_MAX_KRW=300000
# AGENT_AUTO_DAILY_CAP=30
# AGENT_AUTO_RECEIPT=0
# AGENT_MAX_TOOL_CALLS=6
# AGENT_DAILY_LLM_CALLS=200
# AGENT_SILENCE_HOURS=24
# AGENT_SETTLE_COALESCE_SEC=300
# AGENT_SETTLE_NOTICE_MIN_KRW=1000
# AGENT_SETTLE_NOTICE_HOURS=1
# AGENT_SETTLE_REVIEW_HOLD_DAYS=3

# Ledger / FX
# RECEIPT_MAX_IMAGE_MB=4
# FX_PROVIDER_BASE_URL=https://api.frankfurter.dev
# FX_CACHE_TTL_HOURS=24

# Web Push (private half)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional internal shared secret (legacy alias if used)
# INTERNAL_API_SECRET=

# Local DB push script only (backend/.env) — not used by Next runtime
# DB_PASSWORD=

# =============================================================================
# Removed — do not set (FastAPI / Hotelbeds / WithAct era)
# =============================================================================
# BACKEND_URL=
# NEXT_PUBLIC_BACKEND_URL=
# HOTELBEDS_API_KEY=
# HOTELBEDS_API_SECRET=
# WITHACT_API_BASE=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
